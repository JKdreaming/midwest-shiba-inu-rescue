---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, MISSION, STATES, DOG_ORIGINS } from '../data/site';
---

<BaseLayout
  title="About MSIR | Midwest Shiba Inu Rescue"
  description="Midwest Shiba Inu Rescue (MSIR) is a 501(c)(3) all-volunteer rescue founded in 2002 — a network of foster homes saving Shiba Inu dogs across ten Midwest states."
>
  <section class="relative overflow-hidden bg-navy py-24">
    <div class="absolute inset-0 grid-bg opacity-[0.06]"></div>
    <div class="relative mx-auto max-w-3xl px-5 text-center">
      <div class="kicker !text-orange-light justify-center">About MSIR</div>
      <h1 class="mt-4 text-4xl font-black text-white md:text-5xl">Saving Shibas since 2002</h1>
      <p class="mt-4 text-lg text-white/80">{MISSION}</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-3xl font-black text-navy">How we work</h2>
      <p class="mt-4 leading-relaxed text-ink/80">MSIR is made up entirely of a network of volunteers who work together to make sure every Shiba gets the care they need. Because we have no facility, our dogs live in volunteer foster homes throughout the Midwest — where their medical needs are met and they receive love, care, and a little training until they find their forever home.</p>
      <p class="mt-3 leading-relaxed text-ink/80">We are a registered 501(c)(3) non-profit and licensed rescue, operating across {STATES.length} states: {STATES.join(', ')}.</p>
    </div>

    <div class="mx-auto mt-14 max-w-page px-5">
      <img src="/images/us-service-map.svg" alt="Map of the United States highlighting the 12 Midwest states served by Midwest Shiba Inu Rescue" class="mx-auto w-full max-w-4xl" />
    </div>

    <div class="mx-auto mt-14 max-w-3xl px-5">
      <h2 class="text-3xl font-black text-navy">Where our dogs come from</h2>
      <ul class="mt-4 grid gap-3">
        {DOG_ORIGINS.map((d) => (
          <li class="flex items-start gap-3">
            <svg class="mt-1 h-5 w-5 shrink-0 text-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="text-ink">{d}</span>
          </li>
        ))}
      </ul>

      <div class="mt-12 rounded-2xl bg-sand p-8 text-center">
        <h3 class="text-xl font-black text-navy">Want to be part of it?</h3>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/volunteer/" class="btn-primary">Foster or Volunteer</a>
          <a href="/donate/" class="btn-secondary">Donate</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
