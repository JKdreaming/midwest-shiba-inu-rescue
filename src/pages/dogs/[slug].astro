---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { DOGS, getDog, type Dog } from '../../data/dogs';
import { FORMS } from '../../data/site';

export function getStaticPaths() {
  return DOGS.filter((d) => d.hasProfile).map((d) => ({ params: { slug: d.slug }, props: { dog: d } }));
}

const { dog } = Astro.props as { dog: Dog };

const statusStyle: Record<Dog['status'], { dot: string; badge: string }> = {
  available: { dot: '#2f9e44', badge: 'bg-[#e8f5ec] text-[#1e7a33]' },
  pending: { dot: '#e07a1f', badge: 'bg-[#fdf1e2] text-[#a85c0f]' },
  new: { dot: '#8a8177', badge: 'bg-[#f0ece7] text-[#6f665d]' },
};

const featured = dog.photos[0] ?? dog.cardImage;
---

<BaseLayout
  title={`Adopt ${dog.name} — ${dog.sex === 'Male' ? 'Male' : dog.sex === 'Female' ? 'Female' : ''} Shiba Inu | Midwest Shiba Inu Rescue`}
  description={`Meet ${dog.name}, a ${dog.age} ${dog.sex.toLowerCase()} Shiba Inu currently fostered in ${dog.fosterLocation}. ${dog.bio[0]}`}
>
  <section class="bg-white pb-16 pt-10">
    <div class="mx-auto max-w-page px-5">
      <nav class="text-sm text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-orange">Home</a> <span class="mx-1">/</span>
        <a href="/available-dogs/" class="hover:text-orange">Available Dogs</a> <span class="mx-1">/</span>
        <span class="text-ink">{dog.name}</span>
      </nav>

      <div class="mt-8 grid items-start gap-10 lg:grid-cols-2">
        <!-- Featured image -->
        <div>
          <img src={featured} alt={`${dog.name}, a ${dog.age} Shiba Inu`} class="w-full h-auto rounded-2xl" />
        </div>

        <!-- Details -->
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-4xl font-black text-navy md:text-5xl">{dog.name}</h1>
            <span class={`inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${statusStyle[dog.status].badge}`}>
              <span class="h-2 w-2 rounded-full" style={`background: ${statusStyle[dog.status].dot}`}></span>
              {dog.statusLabel}
            </span>
          </div>

          <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm font-semibold text-muted">
            <span>Sex: <span class="text-ink">{dog.sex}</span></span>
            <span>Age: <span class="text-ink">{dog.age}</span></span>
            <span>Weight: <span class="text-ink">{dog.weight}</span></span>
          </div>
          <p class="mt-2 text-sm text-muted">Currently fostered near <span class="font-semibold text-ink">{dog.fosterLocation}</span></p>

          <div class="mt-5 flex flex-wrap gap-2">
            {dog.traits.map((t) => (
              <span class="rounded-full bg-sand px-3 py-1 text-xs font-semibold text-ink/80">{t}</span>
            ))}
          </div>

          <div class="mt-6 space-y-4">
            {dog.bio.map((p) => (
              <p class="leading-relaxed text-ink/85">{p}</p>
            ))}
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={FORMS.adoption} target="_blank" rel="noopener" class="btn-primary">Apply to Adopt {dog.name}</a>
            <a href="/adoption-process/" class="btn-secondary">Adoption Fees</a>
          </div>
          <p class="mt-4 text-xs text-muted">An adoption application must be on file to be considered. MSIR is a best-fit rescue — not first-come, first-served.</p>
        </div>
      </div>
    </div>
  </section>

  {dog.photos.length > 1 && (
    <section class="bg-cream py-16">
      <div class="mx-auto max-w-page px-5">
        <div class="kicker text-orange">Photo gallery</div>
        <h2 class="mt-2 text-3xl font-black text-navy">More of {dog.name}</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {dog.photos.slice(1).map((p) => (
            <img src={p} alt={`${dog.name} — Shiba Inu`} class="w-full h-auto rounded-xl" loading="lazy" />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="text-3xl font-black text-navy">Ready to meet {dog.name}?</h2>
      <p class="mt-3 text-ink/80">The entire household (including canine members) is required to travel to the dog for a meet &amp; greet. We require a 24-hour period between the meet &amp; greet and finalizing the adoption.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={FORMS.adoption} target="_blank" rel="noopener" class="btn-primary">Start Your Application</a>
        <a href="/available-dogs/" class="btn-secondary">See All Dogs</a>
      </div>
    </div>
  </section>
</BaseLayout>
