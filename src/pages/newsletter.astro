---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="MSIR Quarterly Newsletter | Midwest Shiba Inu Rescue"
  description="Sign up for the Midwest Shiba Inu Rescue quarterly newsletter — or volunteer to write it! We don't have a newsletter right now and need your help."
>
  <section class="relative overflow-hidden bg-orange py-24">
    <div class="absolute inset-0 grid-bg opacity-[0.06]"></div>
    <div class="relative mx-auto max-w-3xl px-5 text-center">
      <div class="kicker !text-white/90 justify-center">MSIR Quarterly Newsletter</div>
      <h1 class="mt-4 text-4xl font-black text-white md:text-5xl">You caught us sleeping on the job!</h1>
      <p class="mt-4 text-lg text-white/80">We don&rsquo;t actually have a newsletter right now \u2014 we need a volunteer to write and distribute it.</p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-3xl px-5">
      <div class="card p-8 text-center">
        <h2 class="text-2xl font-black text-navy">Want to write it?</h2>
        <p class="mt-3 text-ink/80">We need a volunteer to write and distribute our quarterly newsletter. If you love telling stories about Shibas (and who doesn&rsquo;t?), this is the role for you.</p>
        <a href="/volunteer/" class="btn-primary mt-6">Become a Volunteer</a>
      </div>

      <div class="mt-8 card p-8 text-center">
        <h2 class="text-2xl font-black text-navy">Stay in the loop</h2>
        <p class="mt-3 text-ink/80">Sign up to receive news and updates by email.</p>
        <a href={`mailto:${SITE.email}?subject=Newsletter%20signup`} class="btn-secondary mt-6">Email Us to Subscribe</a>
        <p class="mt-4 text-xs text-muted">We respect your privacy.</p>
      </div>
    </div>
  </section>
</BaseLayout>
