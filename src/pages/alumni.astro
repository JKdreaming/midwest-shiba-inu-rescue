---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ALUMNI } from '../data/alumni';
---

<BaseLayout
  title="MSIR Alumni — Adopted Shibas | Midwest Shiba Inu Rescue"
  description="Meet some of the Shiba Inu dogs adopted through Midwest Shiba Inu Rescue — congratulations on finding your furever home!"
>
  <section class="relative overflow-hidden bg-navy py-24">
    <div class="absolute inset-0 grid-bg opacity-[0.06]"></div>
    <div class="relative mx-auto max-w-3xl px-5 text-center">
      <div class="kicker !text-orange-light justify-center">MSIR Alumni</div>
      <h1 class="mt-4 text-4xl font-black text-white md:text-5xl">Found their furever homes</h1>
      <p class="mt-4 text-lg text-white/80">These are the Shibas who once waited on our Available Dogs page — and found their furever homes. Congratulations!</p>
      <a href="/available-dogs/" class="mt-6 inline-block text-sm font-semibold text-orange-light hover:underline">See who&rsquo;s available now &rarr;</a>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="mx-auto max-w-page px-5">
      <div class="columns-2 gap-4 md:columns-3 lg:columns-4">
        {ALUMNI.map((a) => (
          <figure class="group relative mb-4 break-inside-avoid overflow-hidden rounded-xl">
            <img src={a.image} alt={`${a.name} — adopted Shiba Inu`} class="w-full h-auto" loading="lazy" />
            <div class="absolute inset-0 flex items-end bg-gradient-to-t from-navy/90 via-navy/25 to-transparent opacity-0 transition duration-200 group-hover:opacity-100">
              <span class="p-4 font-heading text-lg font-black text-white">Let&rsquo;s take a look at {a.name}</span>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-cream py-16">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <h2 class="text-3xl font-black text-navy">Ready to write your own story?</h2>
      <p class="mt-3 text-ink/80">Adopting a rescue is how these happy endings begin. See who's waiting for a home right now.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/available-dogs/" class="btn-primary">See Available Dogs</a>
        <a href="/adoption-process/" class="btn-secondary">Adoption Process</a>
      </div>
    </div>
  </section>
</BaseLayout>
