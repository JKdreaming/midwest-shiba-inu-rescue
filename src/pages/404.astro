---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found | Midwest Shiba Inu Rescue" description="This page could not be found." noindex>
  <section class="bg-navy py-32 text-center">
    <div class="mx-auto max-w-xl px-5">
      <p class="font-heading text-7xl font-black text-orange">404</p>
      <h1 class="mt-4 text-3xl font-black text-white">This page wandered off-leash</h1>
      <p class="mt-4 text-white/75">The page you're looking for doesn't exist — but there's a Shiba who would love to meet you.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/available-dogs/" class="btn-outline">See Available Dogs</a>
      </div>
    </div>
  </section>
</BaseLayout>
