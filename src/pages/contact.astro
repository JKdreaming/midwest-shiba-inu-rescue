---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, COORDINATORS } from '../data/site';
---

<BaseLayout
  title="Contact MSIR | Midwest Shiba Inu Rescue"
  description="Contact Midwest Shiba Inu Rescue — mailing address, phone, and volunteer coordinator email addresses for adoptions, fostering, volunteering, and donations."
>
  <section class="relative overflow-hidden bg-navy py-24">
    <div class="absolute inset-0 grid-bg opacity-[0.06]"></div>
    <div class="relative mx-auto max-w-3xl px-5 text-center">
      <div class="kicker !text-orange-light justify-center">Contact</div>
      <h1 class="mt-4 text-4xl font-black text-white md:text-5xl">How to reach us</h1>
      <p class="mt-4 text-lg text-white/80">Not sure who to contact? Email {SITE.email} and we will route your message.</p>
    </div>
  </section>

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-5">
      <div class="card p-8">
        <h2 class="font-heading text-2xl font-bold text-navy">Mailing address & phone</h2>
        <p class="mt-3 text-ink">{SITE.address}</p>
        <p class="text-ink">{SITE.city}, {SITE.state} {SITE.zip}</p>
        <a href={SITE.phoneHref} class="mt-2 inline-block text-lg font-bold text-orange">{SITE.phone}</a>
      </div>

      <h2 class="mt-12 text-2xl font-black text-navy">Volunteer coordinators</h2>
      <div class="mt-6 grid gap-3">
        {COORDINATORS.map((c) => (
          <div class="flex items-center justify-between gap-4 rounded-xl border border-line bg-cream px-5 py-3">
            <div>
              <p class="font-semibold text-navy">{c.name} <span class="text-muted">— {c.role}</span></p>
            </div>
            <a href={`mailto:${c.email}`} class="shrink-0 text-sm font-semibold text-orange hover:underline">{c.email}</a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
