---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { ADOPTION_FEES, ADOPTION_STEPS, ADOPTION_REQUIREMENTS, FORMS, LINKS, AVG_VET_COST } from '../data/site';
import { DOGS } from '../data/dogs';
---

<BaseLayout
  title="Adoption Process & Fees | Midwest Shiba Inu Rescue"
  description="How to adopt a Shiba Inu from MSIR — adoption fees, requirements, and the step-by-step process. We are a best-fit rescue, not first-come-first-served."
>
  <Hero
    kicker="Adopt a Shiba Inu"
    title="Adopting a Rescued Shiba Inu"
    subtitle="Midwest Shiba Inu Rescue has foster dogs available throughout the Midwest, including IA, IL, IN, KS, MI, MN, MO, NE, OH, and WI."
    image="/images/adopt-dog.jpg"
  />

  <!-- Fees -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-page px-5">
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <div>
          <div class="kicker text-orange">Adoption fees</div>
          <h2 class="mt-3 text-3xl font-black text-navy">What it costs to adopt</h2>
          <p class="mt-4 leading-relaxed text-ink/80">On average, MSIR spends {AVG_VET_COST} per dog on veterinary bills and foster care. The adoption fee covers only a portion of that. Every dog is spayed or neutered, up-to-date on vaccines, heartworm negative, and microchipped — and comes with a <a href={LINKS.fiCollarProgram} target="_blank" rel="noopener" class="font-semibold text-orange hover:underline">Fi GPS collar</a> and a six-month subscription.</p>
          <div class="mt-6 overflow-hidden rounded-2xl border border-line">
            {ADOPTION_FEES.map((f, i) => (
              <div class={`flex items-center justify-between px-5 py-4 ${i % 2 ? 'bg-cream' : 'bg-white'}`}>
                <span class="font-semibold text-ink">{f.range}</span>
                <span class="font-heading text-lg font-black text-orange">{f.fee}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <div class="kicker text-orange">Requirements</div>
          <h2 class="mt-3 text-3xl font-black text-navy">Good to know</h2>
          <ul class="mt-6 grid gap-4">
            {ADOPTION_REQUIREMENTS.map((r) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 shrink-0 text-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-ink">{r}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-3xl px-5">
      <div class="text-center">
        <div class="kicker text-orange justify-center">The process</div>
        <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">Steps to adopting a MSIR rescue dog</h2>
      </div>
      <ol class="mt-10 grid gap-4">
        {ADOPTION_STEPS.map((s, i) => (
          <li class="flex gap-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange font-heading text-sm font-bold text-white">{i + 1}</span>
            <span>
              <span class="block font-heading text-lg font-bold text-navy">{s.title}</span>
              <span class="mt-1 block leading-relaxed text-ink/80">{s.desc}</span>
            </span>
          </li>
        ))}
      </ol>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={FORMS.adoption} target="_blank" rel="noopener" class="btn-primary">Apply to Adopt</a>
        <a href="/available-dogs/" class="btn-secondary">See Available Dogs</a>
      </div>
      <p class="mt-6 text-center text-sm text-muted">Due to the volume of applications and our all-volunteer team, not every applicant will receive a response — we do our best. MSIR reserves the right to refuse adoption to anyone. Questions? Email <a href="mailto:adoptions@shibarescue.org" class="font-semibold text-orange hover:underline">adoptions@shibarescue.org</a>.</p>
    </div>
  </section>

  <!-- Available dogs marquee -->
  <section class="bg-white py-16">
    <div class="mx-auto max-w-page px-5">
      <div class="mb-6 text-center">
        <h2 class="text-3xl font-black text-navy">Available for adoption</h2>
        <a href="/available-dogs/" class="mt-1 inline-block text-sm font-semibold text-orange hover:underline">See all available dogs &rarr;</a>
      </div>
      <div class="overflow-hidden">
        <div class="marquee-track flex w-max items-center">
          <div class="flex shrink-0 items-center gap-6 pr-6">
            {DOGS.map((d) => (
              <a href={d.hasProfile ? `/dogs/${d.slug}/` : '/available-dogs/'} class="group flex w-96 shrink-0 flex-col items-center gap-2">
                <div class="relative">
                  <img src={d.cardImage} alt={`${d.name}, a Shiba Inu`} class="h-96 w-96 rounded-full object-cover object-top transition duration-200 group-hover:scale-105" loading="lazy" />
                  <div class="absolute inset-0 flex flex-col items-center justify-center rounded-full bg-navy/75 opacity-0 transition duration-200 group-hover:opacity-100">
                    <span class="px-6 text-center font-heading text-base font-semibold text-white/85">Let&rsquo;s take a look at</span>
                    <span class="mt-1 px-6 text-center font-heading text-2xl font-black text-white">{d.name}</span>
                  </div>
                </div>
                <span class="text-base font-semibold text-ink/70">{d.name}</span>
              </a>
            ))}
          </div>
          <div class="flex shrink-0 items-center gap-6 pr-6" aria-hidden="true">
            {DOGS.map((d) => (
              <span class="flex w-96 shrink-0 flex-col items-center gap-2">
                <img src={d.cardImage} alt="" class="h-96 w-96 rounded-full object-cover object-top" loading="lazy" />
                <span class="text-base font-semibold text-ink/70">{d.name}</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
