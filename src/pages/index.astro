---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { SITE, MISSION, STATES, HELP_PATHS, DOG_ORIGINS, FAQ } from '../data/site';
---

<BaseLayout
  title="Midwest Shiba Inu Rescue | Adopt a Shiba Inu — Foster, Volunteer, Donate"
  description="Midwest Shiba Inu Rescue (MSIR) saves and places Shiba Inu dogs across the Midwest. A 501(c)(3) all-volunteer network of foster homes. Adopt, foster, volunteer, or donate."
>
  <Hero
    kicker="Since 2002 · A 501(c)(3) Rescue"
    title="Save a Shiba. Change a life."
    subtitle="We rescue, foster, and place Shiba Inu dogs across the Midwest — one loving home at a time. You can help."
    image="/images/hero-dog.jpg"
  />

  <!-- Who we are -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-page px-5">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <div class="kicker text-orange">Who we are</div>
          <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">A network of volunteers, not a facility</h2>
          <p class="mt-4 leading-relaxed text-ink/80">{MISSION}</p>
          <p class="mt-3 leading-relaxed text-ink/80">MSIR dogs live in volunteer foster homes where their medical needs are taken care of, and they receive love, care, and a little training until they find their forever home.</p>
          <a href="/about/" class="btn-secondary mt-8">More About MSIR</a>
        </div>
        <div class="rounded-2xl bg-sand p-8">
          <h3 class="font-heading text-lg font-bold text-orange">We serve the Midwest</h3>
          <p class="mt-2 text-sm text-muted">Saving and placing Shibas across {STATES.length} states:</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {STATES.map((s) => (
              <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-ink/70">{s}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How you can help -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-page px-5">
      <div class="text-center">
        <div class="kicker text-orange justify-center">How you can help</div>
        <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">Four ways to save a Shiba</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {HELP_PATHS.map((h) => (
          <a href={`/${h.slug}/`} class="card group p-6 transition hover:-translate-y-1 hover:shadow-lg">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-orange/15 text-orange">
              {h.icon === 'paw' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-7c3 0 6.5 3 8.5 5.5l-.7.7C18 8.5 15 6 12 6S6 8.5 4.2 10.2l-.7-.7C5.5 4 9 4 12 4zm0-4c4.5 0 9 3 11.5 5.5l-.7.7C20.5 4.5 16.5 2 12 2S3.5 4.5 1.2 6.2l-.7-.7C3 3 7.5 0 12 0z"/></svg>}
              {h.icon === 'home' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>}
              {h.icon === 'heart' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>}
              {h.icon === 'gift' && <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M12 8v13M19 12v7a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-7M7.5 8a2.5 2.5 0 0 1 0-5C11 3 12 8 12 8s1-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>}
            </span>
            <h3 class="mt-4 font-heading text-xl font-bold text-navy group-hover:text-orange transition">{h.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{h.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Where dogs come from -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-page px-5">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <img src="/images/adopt-dog.jpg" alt="A rescued Shiba Inu" class="h-80 w-full rounded-2xl object-cover" loading="lazy" />
        <div>
          <div class="kicker text-orange">Where our dogs come from</div>
          <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">Every Shiba has a story</h2>
          <ul class="mt-6 grid gap-3">
            {DOG_ORIGINS.map((d) => (
              <li class="flex items-start gap-3">
                <svg class="mt-1 h-5 w-5 shrink-0 text-orange" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-ink">{d}</span>
              </li>
            ))}
          </ul>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/available-dogs/" class="btn-primary">See Available Dogs</a>
            <a href="/adoption-process/" class="btn-secondary">Adoption Process</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-cream py-20">
    <div class="mx-auto max-w-3xl px-5">
      <div class="text-center">
        <div class="kicker text-orange justify-center">FAQ</div>
        <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">Common questions</h2>
      </div>
      <div class="mt-10 grid gap-4">
        {FAQ.slice(0, 4).map((f) => (
          <details class="card group overflow-hidden p-5">
            <summary class="cursor-pointer font-heading text-xl font-bold text-navy group-open:text-orange">{f.q}</summary>
            <p class="mt-3 leading-relaxed text-ink">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
