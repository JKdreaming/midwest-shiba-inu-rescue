---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { STATES, FORMS } from '../data/site';
---

<BaseLayout
  title="Available Dogs for Adoption | Midwest Shiba Inu Rescue"
  description="See the Shiba Inu dogs currently available for adoption through Midwest Shiba Inu Rescue — each one living in a foster home across the Midwest."
>
  <Hero
    kicker="Available Dogs"
    title="Find Your New Best Friend"
    subtitle="Every MSIR Shiba lives in a volunteer foster home. Each dog has a unique personality and needs — read listings carefully."
    image="/images/adopt-dog.jpg"
    imagePos="50% -60px"
  />

  <section class="bg-white py-20">
    <div class="mx-auto max-w-3xl px-5 text-center">
      <div class="kicker text-orange justify-center">Our dogs</div>
      <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">Each Shiba is waiting in a foster home</h2>
      <p class="mt-4 leading-relaxed text-ink/80">Our available dogs change often as Shibas find their forever homes. Every listing includes the dog's personality, needs, and foster location across {STATES.slice(0, 5).join(', ')}, and more.</p>
      <div class="mt-8 rounded-2xl bg-sand p-8">
        <p class="font-semibold text-navy">To see today's dogs and read their full stories, visit our live listings:</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="https://www.shibarescue.org/availabledogs" target="_blank" class="btn-primary">View Current Available Dogs</a>
          <a href={FORMS.adoption} target="_blank" rel="noopener" class="btn-secondary">Apply to Adopt</a>
        </div>
      </div>
      <p class="mt-6 text-sm text-muted">The entire household (including canine members) is required to travel to the dog for a meet & greet. We are a best-fit rescue — not first-come, first-served.</p>
    </div>
  </section>
</BaseLayout>
