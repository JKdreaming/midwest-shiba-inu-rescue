---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { DOGS, type Dog } from '../data/dogs';
import { FORMS } from '../data/site';

const statusStyle: Record<Dog['status'], { dot: string; badge: string }> = {
  available: { dot: '#2f9e44', badge: 'bg-[#e8f5ec] text-[#1e7a33]' },
  pending: { dot: '#e07a1f', badge: 'bg-[#fdf1e2] text-[#a85c0f]' },
  new: { dot: '#8a8177', badge: 'bg-[#f0ece7] text-[#6f665d]' },
};
---

<BaseLayout
  title="Available Dogs for Adoption | Midwest Shiba Inu Rescue"
  description="Meet the Shiba Inu dogs currently available for adoption through Midwest Shiba Inu Rescue — each one living in a volunteer foster home across the Midwest."
>
  <Hero
    kicker="Available Dogs"
    title="Meet Our Foster Dogs"
    subtitle="Every MSIR Shiba lives in a volunteer foster home. An adoption application must be on file to be considered for adoption."
    image="/images/adopt-dog.jpg"
    imagePos="50% -140px"
  />

  <section class="bg-white py-16">
    <div class="mx-auto max-w-page px-5">
      <div class="max-w-2xl">
        <div class="kicker text-orange">MSIR's current foster dogs</div>
        <h2 class="mt-3 text-3xl font-black text-navy md:text-4xl">Waiting for their forever homes</h2>
        <p class="mt-4 text-ink/80">Each Shiba has a unique personality and needs. Read their stories, then submit an application to be considered. We are a best-fit rescue — not first-come, first-served.</p>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {DOGS.map((d) => (
          <article class="card group flex flex-col overflow-hidden">
            <div class="relative">
              <img src={d.cardImage} alt={`${d.name}, a Shiba Inu`} class="aspect-square w-full object-cover object-top" loading="lazy" />
              <span class={`absolute left-3 top-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide ${statusStyle[d.status].badge}`}>
                <span class="h-2 w-2 rounded-full" style={`background: ${statusStyle[d.status].dot}`}></span>
                {d.statusLabel}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-heading text-2xl font-bold text-navy">{d.name}</h3>
              <p class="mt-1 text-sm font-semibold text-muted">{d.sex} · {d.age} · {d.weight}</p>
              <p class="mt-1 text-sm text-muted">Fostered near {d.fosterLocation}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {d.traits.slice(0, 3).map((t) => (
                  <span class="rounded-full bg-sand px-2.5 py-0.5 text-xs font-semibold text-ink/70">{t}</span>
                ))}
              </div>
              <div class="mt-auto pt-5">
                {d.hasProfile ? (
                  <a href={`/dogs/${d.slug}/`} class="btn-primary w-full justify-center !px-4 !py-2.5 text-xs">Meet {d.name}</a>
                ) : (
                  <a href={FORMS.adoption} target="_blank" rel="noopener" class="btn-secondary w-full justify-center !px-4 !py-2.5 text-xs">Apply to Adopt</a>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>

      <p class="mt-8 text-center text-sm text-muted">The entire household (including canine members) is required to travel to the dog for a meet &amp; greet. We require a 24-hour period between the meet &amp; greet and finalizing the adoption.</p>
    </div>
  </section>
</BaseLayout>
