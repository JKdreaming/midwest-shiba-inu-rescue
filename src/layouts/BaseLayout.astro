---
import '../styles/global.css';
import { SITE, STATES, COORDINATORS, MISSION } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = '/images/hero-dog.jpg', noindex = false } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'NonprofitOrganization',
  name: SITE.name,
  alternateName: 'MSIR',
  url: SITE.domain,
  email: SITE.email,
  telephone: '+16302964455',
  foundingDate: '2002',
  nonprofitStatus: 'Nonprofit501c3',
  address: {
    '@type': 'PostalAddress',
    postOfficeBoxNumber: '8163',
    addressLocality: SITE.city,
    addressRegion: 'IL',
    postalCode: SITE.zip,
    addressCountry: 'US',
  },
  areaServed: STATES.map((s) => ({ '@type': 'State', name: s })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, SITE.domain).href} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <header class="sticky top-0 z-50 border-b border-line bg-cream/95 backdrop-blur">
      <nav class="mx-auto flex max-w-page items-center justify-between gap-4 px-5 py-3">
        <a href="/" class="flex shrink-0 items-center gap-2" aria-label={`${SITE.name} home`}>
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-orange/15 text-orange">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 11c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-7c3 0 6.5 3 8.5 5.5l-.7.7C18 8.5 15 6 12 6S6 8.5 4.2 10.2l-.7-.7C5.5 4 9 4 12 4zm0-4c4.5 0 9 3 11.5 5.5l-.7.7C20.5 4.5 16.5 2 12 2S3.5 4.5 1.2 6.2l-.7-.7C3 3 7.5 0 12 0z"/></svg>
          </span>
          <span class="font-heading text-lg font-bold leading-tight text-navy">Midwest Shiba<br class="hidden sm:block" /> Inu Rescue</span>
        </a>
        <div class="hidden items-center gap-6 lg:flex">
          <a href="/adoption-process/" class="text-sm font-semibold text-navy transition hover:text-orange">Adopt</a>
          <a href="/available-dogs/" class="text-sm font-semibold text-navy transition hover:text-orange">Available Dogs</a>
          <a href="/volunteer/" class="text-sm font-semibold text-navy transition hover:text-orange">Foster & Volunteer</a>
          <a href="/about/" class="text-sm font-semibold text-navy transition hover:text-orange">About</a>
          <a href="/contact/" class="text-sm font-semibold text-navy transition hover:text-orange">Contact</a>
        </div>
        <div class="flex items-center gap-3">
          <a href="/donate/" class="btn-primary hidden !px-5 !py-2.5 md:inline-flex">Donate</a>
          <button id="menu-toggle" class="flex h-10 w-10 items-center justify-center rounded-lg border border-line text-navy lg:hidden" aria-label="Menu" aria-expanded="false">
            <svg id="menu-icon-open" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            <svg id="menu-icon-close" class="hidden h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
      </nav>
      <div id="mobile-menu" class="hidden border-t border-line bg-cream lg:hidden">
        <div class="mx-auto max-w-page px-5 py-4">
          {[
            { label: 'Adopt', href: '/adoption-process/' },
            { label: 'Available Dogs', href: '/available-dogs/' },
            { label: 'Foster & Volunteer', href: '/volunteer/' },
            { label: 'About', href: '/about/' },
            { label: 'Contact', href: '/contact/' },
          ].map((n) => (
            <a href={n.href} class="block border-b border-line py-3 text-base font-semibold text-navy hover:text-orange">{n.label}</a>
          ))}
          <a href="/donate/" class="btn-primary mt-4 w-full justify-center">Donate</a>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <!-- Donate CTA -->
    <section class="bg-orange py-20 text-center">
      <div class="mx-auto max-w-3xl px-5">
        <div class="kicker !text-white/85 justify-center">Give a Shiba a "Leg Up"</div>
        <h2 class="mt-3 text-3xl font-black text-white md:text-4xl">Help save a Shiba Inu today</h2>
        <p class="mx-auto mt-4 max-w-xl text-white/85">Every dollar goes to the dogs — food, medical care, spay/neuter, and the foster homes that heal them.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="inline-flex items-center justify-center gap-2 rounded-full bg-white px-8 py-3.5 font-heading text-sm font-bold uppercase tracking-wide text-orange transition hover:bg-cream" href={SITE.paypal} target="_blank">Donate via PayPal</a>
          <a class="btn-outline" href="/volunteer/">Volunteer</a>
        </div>
      </div>
    </section>

    <footer class="bg-navy-dark py-16 text-white">
      <div class="mx-auto max-w-page px-5">
        <div class="grid gap-10 md:grid-cols-4">
          <div>
            <p class="font-heading text-lg font-bold text-white">{SITE.name}</p>
            <p class="mt-3 text-sm text-white/70">A non-profit, all-volunteer network of foster homes saving Shiba Inu dogs across the Midwest since 2002.</p>
          </div>
          <div>
            <h3 class="font-heading text-base font-bold text-white">Adopt & Help</h3>
            <ul class="mt-4 space-y-2 text-sm text-white/70">
              <li><a href="/available-dogs/" class="hover:text-white">Available Dogs</a></li>
              <li><a href="/adoption-process/" class="hover:text-white">Adoption Process</a></li>
              <li><a href="/is-a-shiba-right-for-you/" class="hover:text-white">Is a Shiba Right For You?</a></li>
              <li><a href="/volunteer/" class="hover:text-white">Foster & Volunteer</a></li>
              <li><a href="/donate/" class="hover:text-white">Donate</a></li>
            </ul>
          </div>
          <div>
            <h3 class="font-heading text-base font-bold text-white">Contact</h3>
            <div class="mt-4 space-y-2 text-sm text-white/70">
              <p>{SITE.address}, {SITE.city}, {SITE.state} {SITE.zip}</p>
              <a href={SITE.phoneHref} class="block font-bold text-white hover:text-orange-light">{SITE.phone}</a>
              <a href={`mailto:${SITE.email}`} class="block hover:text-white">{SITE.email}</a>
            </div>
          </div>
          <div>
            <h3 class="font-heading text-base font-bold text-white">Serving the Midwest</h3>
            <p class="mt-4 text-sm text-white/70">{STATES.join(', ')}.</p>
            <a href="/donate/" class="btn-primary mt-5 !px-5 !py-2.5 text-xs">Donate Now</a>
          </div>
        </div>
        <div class="mt-10 border-t border-white/15 pt-5 text-center text-xs text-white/50">
          © {new Date().getFullYear()} {SITE.name}. A registered 501(c)(3) non-profit and licensed rescue.
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const open = document.getElementById('menu-icon-open');
      const close = document.getElementById('menu-icon-close');
      toggle?.addEventListener('click', () => {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        open.classList.toggle('hidden', isOpen);
        close.classList.toggle('hidden', !isOpen);
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    </script>
  </body>
</html>
