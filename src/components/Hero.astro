---
interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  image: string;
  align?: 'left' | 'center';
}
const { title, subtitle, kicker = 'Midwest Shiba Inu Rescue', image, align = 'left' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-navy">
  <div class="absolute inset-0">
    <img src={image} alt={title} class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-navy/90 via-navy/60 to-navy/30"></div>
  </div>
  <div class={`relative mx-auto flex min-h-[70vh] max-w-page items-end px-5 pb-14 pt-28 ${align === 'center' ? 'justify-center text-center' : 'justify-start'}`}>
    <div class="max-w-2xl">
      <div class="kicker text-orange-light">{kicker}</div>
      <h1 class="mt-4 text-4xl font-black leading-[1.05] text-white md:text-5xl lg:text-6xl">{title}</h1>
      {subtitle && <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">{subtitle}</p>}
    </div>
  </div>
</section>
