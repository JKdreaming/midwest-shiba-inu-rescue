---
/**
 * ShibaWalk — a Shiba Inu that walks across the bottom of a hero.
 * Transparent animation strip. Drop inside any positioned/overflow-hidden section:
 *   <div class="absolute inset-x-0 bottom-0"><ShibaWalk /></div>
 */
---
<style>
/* Transparent animation strip. Drop this inside any positioned section. */
  .shiba-strip {
    position: relative;
    width: 100%;
    height: 88px;
    overflow: hidden;
    background: transparent;
    pointer-events: none;
  }

  .shiba-dog {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 110px;
    height: 83px;
    transform-origin: 50% 100%;
    will-change: transform;
  }

  .shiba-pose {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: auto;
    height: 79px;
    opacity: 0;
    transform: translateX(-50%);
    user-select: none;
    -webkit-user-drag: none;
  }

  .shiba-walk-1 { opacity: 1; }
  .shiba-sit { height: 81px; }
  .shiba-play { height: 83px; }

  @media (max-width: 700px) {
    .shiba-strip { height: 76px; }
    .shiba-dog { width: 90px; height: 75px; }
    .shiba-pose { height: 69px; }
    .shiba-sit { height: 71px; }
    .shiba-play { height: 73px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shiba-dog {
      transform: translate3d(16px, 0, 0) !important;
    }
    .shiba-pose { opacity: 0 !important; }
    .shiba-sit { opacity: 1 !important; }
  }
</style>

<div class="shiba-strip" id="shiba-strip">
  <div class="shiba-dog" id="shiba-dog" aria-hidden="true">
    <img class="shiba-pose shiba-walk-1" id="shiba-walk-1" src="data:image/webp;base64," alt="">
    <img class="shiba-pose shiba-walk-2" id="shiba-walk-2" src="data:image/webp;base64," alt="">
    <img class="shiba-pose shiba-sit" id="shiba-sit" src="data:image/webp;base64," alt="">
    <img class="shiba-pose shiba-play" id="shiba-play" src="data:image/webp;base64," alt="">
  </div>
</div>

<script>
(() => {
  const strip = document.getElementById("shiba-strip");
  const dog = document.getElementById("shiba-dog");
  const walk1 = document.getElementById("shiba-walk-1");
  const walk2 = document.getElementById("shiba-walk-2");
  const sit = document.getElementById("shiba-sit");
  const play = document.getElementById("shiba-play");
  const poses = [walk1, walk2, sit, play];

  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  const duration = 18000;
  const started = performance.now();

  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const mix = (a, b, t) => a + (b - a) * t;
  const smooth = t => t * t * (3 - 2 * t);
  const easeOut = t => 1 - Math.pow(1 - t, 3);

  function show(pose) {
    poses.forEach(p => p.style.opacity = p === pose ? "1" : "0");
  }

  function fade(from, to, amount) {
    poses.forEach(p => p.style.opacity = "0");
    from.style.opacity = String(clamp(1 - amount, 0, 1));
    to.style.opacity = String(clamp(amount, 0, 1));
  }

  function animate(now) {
    const width = strip.clientWidth;
    const dogWidth = dog.offsetWidth || 110;
    const leftOff = -dogWidth - 16;
    const rightOff = width + 20;
    const stopX = width * 0.61 - dogWidth * 0.78;

    const elapsed = (now - started) % duration;
    const sec = elapsed / 1000;

    let x = leftOff;
    let direction = 1;
    let walking = false;

    if (sec < 5.7) {
      const p = sec / 5.7;
      x = mix(leftOff, stopX, p < 0.82 ? p : mix(p, smooth(p), 0.45));
      walking = true;
    } else if (sec < 6.25) {
      const p = (sec - 5.7) / 0.55;
      x = mix(stopX - 8, stopX, easeOut(p));
      walking = true;
    } else if (sec < 7.0) {
      x = stopX;
      fade(walk1, sit, smooth((sec - 6.25) / 0.75));
    } else if (sec < 8.15) {
      x = stopX;
      show(sit);
    } else if (sec < 8.55) {
      x = stopX;
      fade(sit, play, smooth((sec - 8.15) / 0.40));
    } else if (sec < 9.35) {
      x = stopX;
      show(play);
    } else if (sec < 9.85) {
      x = stopX;
      fade(play, sit, smooth((sec - 9.35) / 0.50));
    } else if (sec < 10.25) {
      x = stopX;
      fade(sit, walk1, smooth((sec - 9.85) / 0.40));
    } else if (sec < 13.0) {
      x = mix(stopX, rightOff, (sec - 10.25) / 2.75);
      walking = true;
    } else if (sec < 13.65) {
      x = rightOff;
      direction = -1;
      walking = true;
    } else if (sec < 17.65) {
      x = mix(rightOff, leftOff, (sec - 13.65) / 4.0);
      direction = -1;
      walking = true;
    } else {
      x = leftOff;
      direction = 1;
      walking = true;
    }

    if (walking) {
      const phase = Math.floor(elapsed / (1000 / 12)) % 12;
      show(phase >= 3 && phase <= 8 ? walk2 : walk1);
    }

    /* Horizontal travel only. No bounce, no tilt, no background, no extra ball. */
    dog.style.transform = `translate3d(${x}px,0,0) scaleX(${direction})`;

    requestAnimationFrame(animate);
  }

  requestAnimationFrame(animate);
})();
</script>

